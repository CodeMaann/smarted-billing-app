rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Root users collection - User profile, role and subscription information
    match /users/{userId} {
      allow read: if request.auth != null;
      // Allow creation only if the subscription_status is explicitly set to 'trial'
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.subscription_status == 'trial';
      // Allow updates but prevent client tampering with subscription_status, trial_start_date, and account_created_date
      allow update: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription_status', 'trial_start_date', 'account_created_date']));
      allow delete: if false;

      // 1. Bills & Invoices
      match /bills/{billId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 2. Inventory / Catalog Items
      match /catalog/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 3. Customers Ledger & Credit Records
      match /customers/{customerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 4. Suppliers
      match /suppliers/{supplierId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 5. Purchases / Stock Inward Orders
      match /purchases/{purchaseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 6. Expenses
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 7. Delivery Challans
      match /challans/{challanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 8. Estimates / Quotations
      match /estimates/{estimateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 9. Business Profile (shop details, GSTIN, terms)
      match /profile/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 10. Cash Loans given by shop owner
      match /loans/{loanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 11. Catch-all for any other business subcollections (ledger entries, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Invitations collection for staff team invites
    match /invitations/{inviteId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Dedicated backups collection
    match /backups/{backupId} {
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
